{
  "name": "khaled-suleiman-school",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.6.0" },
  "overrides": { "postcss": "8.5.30" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:windows": "node scripts/build-windows.mjs",
    "start": "next start -p ${PORT:-3200}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "prisma generate || true"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.2",
    "dotenv": "16.6.1",
    "jose": "6.1.0",
    "lucide-react": "0.544.0",
    "next": "15.5.27",
    "pg": "8.16.3",
    "prisma": "7.10.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.186.1",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.186.0",
    "typescript": "5.9.2"
  }
}
