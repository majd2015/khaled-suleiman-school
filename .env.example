# رابط الموقع المنشور (يُستخدم في روابط منشورات فيسبوك وإنستجرام)
SITE_URL=https://example.com

# قاعدة البيانات وتسجيل الدخول (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# نص عشوائي طويل لإخفاء هوية المصوّتين
VOTE_SALT=change-me

# النشر التلقائي على فيسبوك وإنستجرام (Meta Graph API)
META_GRAPH_VERSION=v21.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
