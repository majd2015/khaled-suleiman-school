# رابط الموقع المنشور (روابط الأخبار والصور في منشورات فيسبوك وإنستجرام)
SITE_URL=https://example.com

# قاعدة البيانات: من Coolify → قاعدة Postgres → Internal URL
DATABASE_URL=postgresql://school:school@127.0.0.1:5432/school?schema=public

# نص عشوائي 32 حرفًا على الأقل لتوقيع جلسات تسجيل الدخول: openssl rand -base64 48
SESSION_SECRET=

# أول حساب مدير، يُنشأ عند أول تشغيل فقط إذا لم يوجد مدير (كلمة السر 10 أحرف على الأقل)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 1 لنسخ المحتوى التجريبي إلى قاعدة البيانات الفارغة عند التشغيل
SEED_DEMO=0

# مجلد الصور المرفوعة (على Coolify: Persistent Storage مربوط بـ /app/uploads)
UPLOAD_DIR=/app/uploads

# نص عشوائي طويل لإخفاء هوية المصوّتين: openssl rand -base64 32
VOTE_SALT=

# النشر التلقائي على فيسبوك وإنستجرام (Meta Graph API)
META_GRAPH_VERSION=v21.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
