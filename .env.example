# حماية لوحة النشر (أي كلمة سر طويلة)
ADMIN_TOKEN=change-me

# رابط الموقع النهائي، بلا شرطة في آخره. يُقرأ وقت البناء (npm run build).
# اتركه فارغًا حتى يُعتمد الدومين: يبقى الموقع مخفيًا عن محركات البحث (noindex)
# وتبقى خريطة الموقع فارغة. عند تعبئته تُفعَّل الفهرسة وخريطة الموقع وروابط المشاركة الكاملة.
SITE_URL=

# النشر التلقائي على فيسبوك وإنستجرام (Meta Graph API)
META_GRAPH_VERSION=v21.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
